{
  "entities": {
    "LoteBloqueio": {
      "title": "LoteBloqueio",
      "description": "Lotes de bloqueio vendidos mas ainda não produzidos com prioridade máxima",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "produto": { "type": "string" },
        "codigoProduto": { "type": "string" },
        "numeroLote": { "type": "string" },
        "maquina": { "type": "string" },
        "setor": { "type": "string" },
        "prazo": { "type": "string", "enum": ["hoje", "semana", "mes"] },
        "dataLimite": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "em_andamento", "concluido", "cancelado"] },
        "observacoes": { "type": "string" },
        "criadoEm": { "type": "string" },
        "concluidoEm": { "type": "string" }
      },
      "required": ["produto", "numeroLote", "maquina", "prazo", "status"]
    },
    "MembroEquipe": {
      "title": "MembroEquipe",
      "description": "Membros das equipes responsáveis dos setores de produção (Semissólidos e Líquidos)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "setor": { "type": "string", "enum": ["semissolidos", "liquidos"] },
        "turno": { "type": "string" },
        "cargo": { "type": "string" },
        "nome": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "setor", "turno", "cargo", "nome"]
    },
    "Produto": {
      "title": "Produto",
      "description": "Produtos e medicamentos fabricados na planta farmacêutica",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigo": { "type": "string" },
        "nome": { "type": "string" },
        "setor": { "type": "string", "enum": ["semissolidos", "liquidos"] },
        "linha": { "type": "string" },
        "tempoEnvaseMinutos": { "type": "number" }
      },
      "required": ["id", "nome", "setor", "linha", "tempoEnvaseMinutos"]
    }
  },
  "firestore": {
    "/lotesBloqueio/{id}": {
      "schema": "LoteBloqueio",
      "description": "Coleção de lotes de bloqueio de alta prioridade"
    },
    "/equipes/{id}": {
      "schema": "MembroEquipe",
      "description": "Coleção de membros das equipes responsáveis por setor"
    },
    "/produtos/{id}": {
      "schema": "Produto",
      "description": "Coleção de produtos e tempos de envase"
    }
  }
}
